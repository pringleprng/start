<?xml version="1.0" encoding="utf-8"?>
<!-- [DumbTube] Card watched-progress bar for the OLED neon theme -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:id="@android:id/background">
        <shape>
            <solid android:color="@color/dumbtube_track"/>
        </shape>
    </item>
    <item android:id="@android:id/progress">
        <clip>
            <shape>
                <solid android:color="@color/dumbtube_neon"/>
            </shape>
        </clip>
    </item>
</layer-list>
